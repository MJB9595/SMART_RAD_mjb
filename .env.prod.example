# [1] 도메인 및 API URL 설정
# 프론트엔드가 접속할 백엔드 API 주소
# (시놀로지 역방향 프록시에서 별도로 백엔드용 도메인(예: api.tsms.mjb.diskstation.me -> 8080포트)을 뚫어주셨다면 그 주소를 기입합니다.)
# (만약 시놀로지에서 /api 경로를 8080으로 라우팅하도록 설정하셨다면 아래와 같이 씁니다.)
API_BASE_URL=https://tsms.mjb.diskstation.me/api

# 백엔드 CORS 허용 도메인 (프론트엔드 도메인 기입)
CORS_ALLOWED_ORIGINS=https://tsms.mjb.diskstation.me

# 카카오톡·슬랙 링크 미리보기(og:image)와 canonical 에 쓰이는 사이트 절대 주소.
# 프론트 이미지 "빌드 시점"에 박히므로, 도메인이 바뀌면 프론트를 다시 빌드해야 한다.
SITE_URL=https://tsms.mjb.diskstation.me

# [2] 카카오 로그인 연동 설정
KAKAO_REST_API_KEY=your_kakao_api_key
KAKAO_CLIENT_SECRET=your_kakao_client_secret
# 카카오 개발자 센터에 등록해야 할 실제 Redirect URI
KAKAO_REDIRECT_URI=https://tsms.mjb.diskstation.me/oauth/kakao/callback

# [3] 백엔드 보안 설정
JWT_SECRET=change-this-secret-key-in-production-min-32chars!

# [4] 데이터베이스 설정
DB_ROOT_PASSWORD=strong_root_password
DB_NAME=tp_hr
DB_USER=tp_hr_user
DB_PASSWORD=strong_db_password
