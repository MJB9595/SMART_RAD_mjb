# ---------------------------------------------------------
# HRIS 시스템 운영 서버 배포용 환경변수 템플릿
# ---------------------------------------------------------
# 사용법: 이 파일을 복사하여 `.env` 라는 이름으로 저장하고, 
# 실제 운영 환경에 맞게 값을 변경한 뒤 docker compose up 을 실행하세요.
# (로컬 개발 환경에서는 별도의 .env 파일 없이 기본값으로 동작합니다.)

# [1] 도메인 및 API URL 설정
# 프론트엔드가 접속할 백엔드 API 주소 (실제 운영 서버 도메인 기입)
API_BASE_URL=https://api.yourdomain.com/api
# 백엔드 CORS 허용 도메인 (프론트엔드 도메인 기입)
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# [2] 카카오 로그인 연동 설정 (카카오 개발자 센터 발급 내역)
KAKAO_REST_API_KEY=your_kakao_api_key
KAKAO_CLIENT_SECRET=your_kakao_client_secret
# 카카오 개발자 센터에 등록된 실제 Redirect URI
KAKAO_REDIRECT_URI=https://yourdomain.com/oauth/kakao/callback

# [3] 백엔드 보안 설정
# JWT 토큰 암호화 키 (반드시 유추하기 어려운 32자리 이상의 무작위 문자열로 변경!)
JWT_SECRET=production_random_secret_string_please_generate_a_strong_one

# [4] 데이터베이스 설정
# 운영 서버용 강력한 DB 패스워드 설정 권장
DB_ROOT_PASSWORD=strong_root_password
DB_NAME=tp_hr
DB_USER=tp_hr_user
DB_PASSWORD=strong_db_password
